# ---------------------------------------------------------------------------
# Sentient Layer — environment variables
# Copy to .env and fill in values. Never commit .env.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# Superuser creds — used by alembic migrations (which create roles, replace
# functions, install triggers) AND by db/seeds/* (which run DDL-adjacent ops
# on tables app_runtime cannot touch). MUST stay separate from the app DSN.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sentient

# app_runtime is the lower-privilege role provisioned by migration
# e5f7a1b9c4d6 (2026-05-04 cluster A). All app services (api, orchestrator,
# worker) connect as app_runtime so RLS actually applies and audit_log
# UPDATE/DELETE/TRUNCATE attempts fail at the privilege check.
APP_RUNTIME_USER=app_runtime
APP_RUNTIME_PASSWORD=CHANGEME_app_runtime_password

# DATABASE_URL = app DSN (lower privilege). Used by libs/common/db.py at
# request time. The default below is for running the app from the host
# against the compose postgres; inside compose the api/orchestrator/worker
# blocks override it to use the postgres service hostname.
DATABASE_URL=postgresql+psycopg://app_runtime:CHANGEME_app_runtime_password@localhost:5432/sentient

# MIGRATION_DATABASE_URL = superuser DSN. Used by alembic + seeds. Falls
# back to DATABASE_URL only if explicitly unset.
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/sentient

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- MinIO ------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET_EVIDENCE=evidence

# --- Splunk (remote LAN/VPN) ------------------------------------------------
# Splunk management REST on 8089, HEC on 8088. Ensure these are reachable
# from the docker host (firewall, VPN). Use hostname, not container network.
SPLUNK_HOST=splunk.internal
SPLUNK_PORT=8089
SPLUNK_TOKEN=CHANGEME_service_account_token
SPLUNK_HEC_HOST=splunk.internal
SPLUNK_HEC_PORT=8088
SPLUNK_HEC_TOKEN=CHANGEME_hec_token
SPLUNK_VERIFY_TLS=true

# --- MCP (Splunk MCP server reached by orchestrator + worker) --------------
# FastMCP mounts the streamable_http transport at /mcp. Default points at the
# in-cluster service hostname; override only for hosted-agent → external-MCP
# topologies (post-MVP).
MCP_SPLUNK_URL=http://mcp-splunk:8080/mcp

# --- LLM routing (OpenRouter) ----------------------------------------------
# Founder's master key for cloud-hosted MVP; per-tenant usage tracked in DB.
OPENROUTER_API_KEY=CHANGEME_sk-or-...

# --- LLM direct (optional escape hatch for provider-direct routing) --------
ANTHROPIC_API_KEY=

# --- LangSmith (agent tracing) ---------------------------------------------
LANGSMITH_API_KEY=CHANGEME_ls__...
LANGSMITH_PROJECT=sentient-layer-dev
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- App crypto / secrets ---------------------------------------------------
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TENANT_SECRET_KEY=CHANGEME_fernet_key_base64

# --- Webhook ingest auth ----------------------------------------------------
# Shared secret for Splunk saved-search alert webhook → /api/incidents/ingest
INGEST_WEBHOOK_SECRET=CHANGEME_long_random_string

# --- Dev-only auth bypass ---------------------------------------------------
# 1 = bypass Entra SSO, use dev email. 0 = require real auth.
# MUST be 0 in production.
DEV_BYPASS_AUTH=1
DEV_USER_EMAIL=dev@sentientlayer.ai
